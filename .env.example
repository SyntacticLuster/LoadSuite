# LoadSuite Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# Database Configuration
# =============================================================================
# MySQL connection URL (used when USE_DATABASE=true)
# Format: mysql://username:password@host:port/database?charset=utf8mb4
DATABASE_URL=mysql://loadsuite_user:your_password_here@localhost:3306/loadsuite

# Local dev tip (recommended): connect to a remote cPanel MySQL safely via SSH tunnel,
# then point DATABASE_URL at the forwarded local port.
# Example:
#   ssh -p 21098 -L 3307:127.0.0.1:3306 <cpanel_user>@orbitsuite.cloud
#   DATABASE_URL=mysql://<db_user>:<db_pass>@127.0.0.1:3307/orbiizny_loadsuite?charset=utf8mb4

# Connection pool settings
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# =============================================================================
# Application Settings
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Secret key for session/token signing (generate a strong random string)
SECRET_KEY=change-me-to-a-secure-random-string

# CORS origins (comma-separated)
CORS_ORIGINS=https://orbitsuite.cloud,http://localhost:8000

# =============================================================================
# Feature Flags
# =============================================================================
# Use database for persistence (set to false for in-memory mode)
USE_DATABASE=true

# Enable synthetic load generation on startup
GENERATE_SYNTHETIC_LOADS=true
SYNTHETIC_LOAD_COUNT=250
