# LoadSuite Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://loadsuite_user:your_password_here@localhost:5432/loadsuite_db

# Connection pool settings
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# =============================================================================
# Application Settings
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Secret key for session/token signing (generate a strong random string)
SECRET_KEY=change-me-to-a-secure-random-string

# CORS origins (comma-separated)
CORS_ORIGINS=https://orbitsuite.cloud,http://localhost:8000

# =============================================================================
# Feature Flags
# =============================================================================
# Use database for persistence (set to false for in-memory mode)
USE_DATABASE=true

# Enable synthetic load generation on startup
GENERATE_SYNTHETIC_LOADS=true
SYNTHETIC_LOAD_COUNT=250
