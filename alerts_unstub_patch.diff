+# Helper functions for alert evaluation
+def _get_alert_field_value(load: Load, field: str) -> Any:
+    """Extract the value for a given field from a Load instance."""
+    field = field.lower()
+    if field == "rpm":
+        return load.rpm
+    elif field == "equipment":
+        return load.equipment
+    elif field == "weight":
+        return load.weight_lbs
+    elif field == "distance":
+        return load.distance_miles
+    elif field == "deadhead":
+        return load.deadhead_miles
+    elif field == "broker_rating":
+        # Broker rating stored as string in format "Acme Logistics (4.8)"
+        try:
+            rating_str = load.broker.split("(")[-1].rstrip(")")
+            return float(rating_str)
+        except Exception:
+            return None
+    elif field == "commodity":
+        return load.commodity
+    elif field == "lane":
+        return f"{load.origin_city}, {load.origin_state} -> {load.destination_city}, {load.destination_state}"
+    elif field == "hazmat":
+        return load.hazmat
+    else:
+        return None
+
+
+def _evaluate_alert_condition(value: Any, operator: str, target: Any) -> bool:
+    """Evaluate a single condition."""
+    if value is None:
+        return False
+    op = operator.lower()
+    # Try numeric comparison when possible
+    try:
+        val_num = float(value)
+        target_num = float(target)
+        if op == "gt":
+            return val_num > target_num
+        if op == "gte":
+            return val_num >= target_num
+        if op == "lt":
+            return val_num < target_num
+        if op == "lte":
+            return val_num <= target_num
+        if op == "eq":
+            return val_num == target_num
+    except (ValueError, TypeError):
+        pass
+    # Fallback to string operations
+    value_str = str(value).lower()
+    target_str = str(target).lower()
+    if op == "eq":
+        return value_str == target_str
+    if op == "contains":
+        return target_str in value_str
+    return False
+
+
+class TriggeredAlertResponse(BaseModel):
+    id: UUID
+    name: str
+    description: Optional[str] = None
+    matches_count: int
+    last_triggered: Optional[datetime] = None
+
+
+@app.get("/api/alerts/triggered", response_model=List[TriggeredAlertResponse])
+def list_triggered_alerts(user_id: str = Depends(get_user_id)):
+    """Return enabled alert rules with the count of matching loads."""
+    rules = alert_rules_store.list(user_id)
+    loads = load_store.list(user_id)
+    responses: List[TriggeredAlertResponse] = []
+    for rule in rules:
+        # Only evaluate enabled rules with conditions
+        if not rule.enabled or not rule.conditions:
+            responses.append(
+                TriggeredAlertResponse(
+                    id=rule.id,
+                    name=rule.name,
+                    description=rule.description,
+                    matches_count=0,
+                    last_triggered=rule.last_triggered,
+                )
+            )
+            continue
+        matches = 0
+        for load in loads:
+            match = True
+            for cond in rule.conditions:
+                val = _get_alert_field_value(load, cond.field)
+                if not _evaluate_alert_condition(val, cond.operator, cond.value):
+                    match = False
+                    break
+            if match:
+                matches += 1
+        # If triggered (matches > 0), update last_triggered timestamp
+        if matches > 0:
+            alert_rules_store.update_last_triggered(user_id, rule.id, datetime.utcnow())
+        responses.append(
+            TriggeredAlertResponse(
+                id=rule.id,
+                name=rule.name,
+                description=rule.description,
+                matches_count=matches,
+                last_triggered=rule.last_triggered,
+            )
+        )
+    return responses
